# Optional for local text-only play. Enables speech input and character playback.
GNANI_API_KEY=

# Run db/setup.sql in the Supabase SQL editor before enabling saves or retrieval.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenAI-compatible dialogue provider. Use its base URL including the version path.
DIALOGUE_BASE_URL=
DIALOGUE_API_KEY=
DIALOGUE_MODEL=

HOST=127.0.0.1
PORT=3000
